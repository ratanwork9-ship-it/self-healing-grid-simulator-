:root {
  color-scheme: light;
  --ink: #172033;
  --muted: #657186;
  --line: #dce3ed;
  --panel: #ffffff;
  --page: #f3f6fb;
  --green: #16834a;
  --red: #c12d3a;
  --amber: #b36a0a;
  --blue: #1e65b5;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink); }
button { font: inherit; }
.page-shell { width: min(1220px, calc(100% - 36px)); margin: 0 auto; padding: 28px 0 32px; }
.page-header { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 22px; }
.eyebrow { margin: 0 0 7px; color: var(--blue); font-size: .76rem; font-weight: 800; letter-spacing: .13em; }
h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -.045em; }
h1 span { color: var(--muted); font-weight: 500; }
.subtitle, .panel-copy { margin: 8px 0 0; color: var(--muted); line-height: 1.5; }
.status-badge, .simulation-label { display: inline-flex; align-items: center; border-radius: 999px; padding: 9px 13px; font-size: .75rem; font-weight: 800; letter-spacing: .04em; white-space: nowrap; }
.status-healthy { color: #12683a; background: #e2f7eb; border: 1px solid #b9e7cb; }
.status-fault { color: #a51f2c; background: #ffeaec; border: 1px solid #f5c3c8; }
.status-partial { color: #88500a; background: #fff2d8; border: 1px solid #f1d7a1; }
.main-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(290px, .85fr); gap: 18px; align-items: start; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 17px; padding: 19px; box-shadow: 0 8px 24px rgb(26 42 68 / 4%); }
.panel + .panel { margin-top: 16px; }
.panel h2 { margin: 0; font-size: 1.08rem; letter-spacing: -.02em; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.panel-heading p { margin: 6px 0 0; color: var(--muted); font-size: .88rem; }
.simulation-label { color: #58667b; background: #f1f4f8; font-size: .65rem; }
.grid-visual-wrap { margin: 14px -5px 4px; overflow-x: auto; }
.grid-visual { display: block; width: 100%; min-width: 570px; height: auto; }
.svg-heading { fill: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: .08em; }
.source-node { fill: #eaf2ff; stroke: #8caee0; stroke-width: 2; }
.source-label { fill: #234b83; font-size: 10px; font-weight: 800; }
.feeder-line { stroke: var(--green); stroke-width: 8; stroke-linecap: round; transition: stroke .2s ease; }
.feeder-line.is-fault { stroke: var(--red); }
.feeder-line.is-isolated { stroke: var(--amber); stroke-dasharray: 6 6; }
.section rect { fill: #fff; stroke: #cdd7e4; stroke-width: 2; }
.section.is-fault rect { stroke: var(--red); fill: #fff0f1; }
.section.is-isolated rect { stroke: var(--amber); fill: #fff5df; }
.section-name { fill: var(--ink); text-anchor: middle; font-size: 13px; font-weight: 800; }
.section-state { fill: var(--green); text-anchor: middle; font-size: 10px; font-weight: 800; }
.section.is-fault .section-state { fill: var(--red); }
.section.is-isolated .section-state { fill: var(--amber); }
.tie-line { fill: none; stroke: #97a3b4; stroke-width: 5; stroke-dasharray: 8 7; transition: stroke .2s ease; }
.tie-line.is-closed { stroke: var(--green); stroke-dasharray: none; }
.tie-label-box { fill: #fff; stroke: #dce3ed; }
.tie-label { fill: #657186; text-anchor: middle; font-size: 10px; font-weight: 800; }
.grid-message { fill: var(--ink); font-size: 13px; font-weight: 800; }
.grid-note { fill: var(--muted); font-size: 11px; }
.process-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 15px; }
.process-row div { padding: 11px; border: 1px solid var(--line); border-radius: 11px; background: #fbfcfe; }
.process-row span { display: block; color: var(--blue); font-size: .72rem; font-weight: 900; }
.process-row b { display: block; margin: 4px 0; }
.process-row small { color: var(--muted); line-height: 1.4; }
.fault-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 15px 0 10px; }
.fault-buttons button, .button-secondary { min-height: 42px; padding: 10px 12px; border: 1px solid #d4dce8; border-radius: 10px; color: var(--ink); background: #fff; font-weight: 750; cursor: pointer; transition: background .15s ease, border-color .15s ease, transform .15s ease; }
.fault-buttons button:hover, .button-secondary:hover { background: #f1f6ff; border-color: #9bb8e6; }
button:focus-visible { outline: 3px solid #8ab8ff; outline-offset: 2px; }
button:active { transform: translateY(1px); }
.button-secondary { width: 100%; background: #f6f8fb; }
.metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin: 15px 0 0; }
.metrics div { min-width: 0; padding: 11px; border: 1px solid #e5eaf1; border-radius: 10px; background: #fbfcfe; }
.metrics dt { color: var(--muted); font-size: .74rem; }
.metrics dd { margin: 5px 0 0; overflow-wrap: anywhere; font-size: 1.05rem; font-weight: 800; }
.compact-heading { margin-bottom: 10px; }
.text-button { border: 0; background: transparent; color: var(--blue); cursor: pointer; font-size: .82rem; font-weight: 750; }
.event-log { display: flex; flex-direction: column; gap: 8px; max-height: 180px; overflow: auto; margin: 0; padding-left: 20px; color: #536075; font-size: .82rem; line-height: 1.45; }
.event-log li { padding-left: 2px; }
.event-log li::marker { color: var(--blue); }
.safety-note { margin-top: 18px; padding: 14px 16px; border: 1px solid #ecd8a9; border-radius: 12px; background: #fff9e9; color: #6e5521; font-size: .82rem; line-height: 1.55; }

@media (max-width: 880px) {
  .main-grid { grid-template-columns: 1fr; }
  .side-column { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .side-column .panel + .panel { margin-top: 0; }
  .log-panel { grid-column: 1 / -1; }
}
@media (max-width: 590px) {
  .page-shell { width: min(100% - 22px, 1220px); padding-top: 18px; }
  .page-header { align-items: flex-start; flex-direction: column; }
  .panel { padding: 15px; }
  .side-column { display: block; }
  .side-column .panel + .panel { margin-top: 12px; }
  .process-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .panel-heading { align-items: flex-start; flex-direction: column; }
  .metrics dd { font-size: .98rem; }
}
